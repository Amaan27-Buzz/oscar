{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "types": ["vite/client", "node"],
    "paths": {"react": ["./node_modules/@types/react"], "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"]}
  },
  "include": ["src", "vite.config.ts", "../../expression/**/*.ts", "../../expression/**/*.tsx"]
}
