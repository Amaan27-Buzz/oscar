{
	admin off
	log default {
		exclude http.log.error
	}
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	servers {
		timeouts {
			read_header 5s
			read_body 10s
			write 35s
			idle 30s
		}
		max_header_size 16KB
	}
}

:8080 {
	redir https://{$OSCAR_DOMAIN}{uri} 308
}

{$OSCAR_DOMAIN} {
	# No access log: request URLs and authentication headers can be private.
	@api path /v1/* /v2/grid/*
	handle @api {
		request_body {
			max_size 64KB
		}
		reverse_proxy core:8080 {
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}
	handle {
		respond 404
	}
}
