# OSCAR local development environment template
#
# Copy to .env and fill values locally.
# The real .env is ignored by Git and must never be committed.
# Never place real secrets in this file.

# -----------------------------------------------------------------------------
# GroqCloud — 4 credential slots
# -----------------------------------------------------------------------------
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# -----------------------------------------------------------------------------
# OpenRouter — 4 credential slots
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=

# -----------------------------------------------------------------------------
# NVIDIA NIM — 2 credential slots
# -----------------------------------------------------------------------------
NVIDIA_NIM_API_KEY_1=
NVIDIA_NIM_API_KEY_2=

# -----------------------------------------------------------------------------
# Google AI Studio — 3 credential slots
# -----------------------------------------------------------------------------
GOOGLE_AI_STUDIO_API_KEY_1=
GOOGLE_AI_STUDIO_API_KEY_2=
GOOGLE_AI_STUDIO_API_KEY_3=

# -----------------------------------------------------------------------------
# Z.ai — 2 credential slots
# -----------------------------------------------------------------------------
ZAI_API_KEY_1=
ZAI_API_KEY_2=

# -----------------------------------------------------------------------------
# Ollama Cloud — 2 credential slots
# -----------------------------------------------------------------------------
OLLAMA_CLOUD_API_KEY_1=
OLLAMA_CLOUD_API_KEY_2=

# -----------------------------------------------------------------------------
# Optional local/private model runtimes
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
VLLM_BASE_URL=http://127.0.0.1:8000/v1

# Optional additional local OpenAI-compatible endpoint.
CUSTOM_LOCAL_OPENAI_BASE_URL=
CUSTOM_LOCAL_OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Optional future provider slots
# -----------------------------------------------------------------------------
# Add only placeholders for adapters actually implemented/tested by OSCAR.
# Do not use this file as a frozen master list of every provider in the ecosystem.
